{
  "name": "pinza",
  "version": "0.1.0",
  "private": true,
  "description": "Cuelga cada captura de pantalla nueva en una línea en el borde superior de Windows.",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build:web": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "arch": "depcruise src --config .dependency-cruiser.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm arch && pnpm test && pnpm build:web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "konva": "10.9.1",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@tauri-apps/cli": "2.12.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "npm:eslint-plugin-react-hooks@7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
